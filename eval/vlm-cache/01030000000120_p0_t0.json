[{"input_path": "/home/ubuntu/crops-tab3/01030000000120_p0_t0.png", "page_index": null, "page_count": null, "width": 1050, "height": 1213, "model_settings": {"use_doc_preprocessor": false, "use_layout_detection": true, "use_chart_recognition": false, "use_seal_recognition": false, "use_ocr_for_image_block": false, "format_block_content": false, "merge_layout_blocks": true, "markdown_ignore_labels": ["number", "footnote", "header", "header_image", "footer", "footer_image", "aside_text"], "return_layout_polygon_points": true}, "parsing_res_list": [{"block_label": "text", "block_content": "Sickle cell hemoglobin and normal hemoglobin differ in only a single amino acid out of more than 100 amino acids in the complete hemoglobin protein. This difference in a single amino acid results in the different properties of sickle cell hemoglobin compared to normal hemoglobin.", "block_bbox": [51, 37, 967, 122], "block_id": 0, "block_order": 1, "group_id": 0, "block_polygon_points": [[51.0, 37.0], [967.0, 37.0], [967.0, 122.0], [51.0, 122.0]]}, {"block_label": "text", "block_content": "Hemoglobin is carried inside red blood cells. Normal hemoglobin dissolves in the watery cytosol of red blood cells. Sickle cell hemoglobin is less soluble in the cytosol because:", "block_bbox": [53, 177, 974, 232], "block_id": 1, "block_order": 2, "group_id": 1, "block_polygon_points": [[53.0, 177.0], [974.0, 177.0], [974.0, 232.0], [53.0, 232.0]]}, {"block_label": "text", "block_content": "• Valine (Val) is much less water-soluble than glutamic acid (Glu).", "block_bbox": [86, 252, 699, 277], "block_id": 2, "block_order": 3, "group_id": 2, "block_polygon_points": [[86.0, 252.0], [699.0, 252.0], [699.0, 277.0], [86.0, 277.0]]}, {"block_label": "text", "block_content": "- Amino acid 6 is in a crucial location on the outer surface of the hemoglobin protein.", "block_bbox": [87, 281, 877, 305], "block_id": 3, "block_order": 4, "group_id": 3, "block_polygon_points": [[87.0, 281.0], [877.0, 281.0], [877.0, 305.0], [87.0, 305.0]]}, {"block_label": "text", "block_content": "The chart on the next page shows how the lower solubility of sickle cell hemoglobin results in the symptoms of sickle cell anemia.", "block_bbox": [53, 307, 928, 362], "block_id": 4, "block_order": 5, "group_id": 4, "block_polygon_points": [[53.0, 307.0], [928.0, 307.0], [928.0, 362.0], [53.0, 362.0]]}, {"block_label": "table", "block_content": "<table><tr><td>Genes in DNA</td><td>→</td><td>Protein</td><td>→</td><td>Characteristics</td></tr><tr><td>2 copies of the allele that codes for normal hemoglobin (SS)</td><td>→</td><td>Normal hemoglobin dissolves in the cytosol of red blood cells.\\n<img src=\"imgs/img_in_image_box_425_551_550_685.jpg\" alt=\"Image\"\" /></td><td>→</td><td>Disk-shaped red blood cells can squeeze through the smallest blood vessels  $ \\rightarrow $ normal health\\n<img src=\"imgs/img_in_image_box_815_577_931_697.jpg\" alt=\"Image\"\" /></td></tr><tr><td>2 copies of the allele that codes for sickle cell hemoglobin (ss)</td><td>→</td><td>Sickle cell hemoglobin can clump in long rods in red blood cells.\\n<img src=\"imgs/img_in_image_box_424_972_558_1105.jpg\" alt=\"Image\"\" /></td><td>→</td><td>If sickle cell hemoglobin clumps in long rods  $ \\rightarrow $ sickle-shaped red blood cells  $ \\rightarrow $ clogged small blood vessels + fragile red blood cells  $ \\rightarrow $ pain, damage to body organs + anemia = sickle cell anemia\\n<img src=\"imgs/img_in_image_box_798_1039_945_1182.jpg\" alt=\"Image\"\" /></td></tr></table>", "block_bbox": [11, 422, 1039, 1200], "block_id": 5, "block_order": null, "group_id": 5, "block_polygon_points": [[11.0, 422.0], [1039.0, 422.0], [1039.0, 1200.0], [11.0, 1200.0]]}], "layout_det_res": {"input_path": null, "page_index": null, "boxes": [{"cls_id": 22, "label": "text", "score": 0.9466162919998169, "coordinate": [51, 37, 967, 122], "order": 1, "polygon_points": [[51.0, 37.0], [967.0, 37.0], [967.0, 122.0], [51.0, 122.0]]}, {"cls_id": 22, "