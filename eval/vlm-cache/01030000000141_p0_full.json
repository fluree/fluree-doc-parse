[{"input_path": "/home/ubuntu/crops/01030000000141_p0_full.png", "page_index": null, "page_count": null, "width": 3456, "height": 5184, "model_settings": {"use_doc_preprocessor": false, "use_layout_detection": true, "use_chart_recognition": false, "use_seal_recognition": false, "use_ocr_for_image_block": false, "format_block_content": false, "merge_layout_blocks": true, "markdown_ignore_labels": ["number", "footnote", "header", "header_image", "footer", "footer_image", "aside_text"], "return_layout_polygon_points": true}, "parsing_res_list": [{"block_label": "number", "block_content": "10", "block_bbox": [203, 160, 364, 313], "block_id": 0, "block_order": null, "group_id": 0, "block_polygon_points": [[203.0, 160.0], [364.0, 160.0], [364.0, 313.0], [203.0, 313.0]]}, {"block_label": "header", "block_content": "THINGS YOU SHOULD KNOW ABOUT", "block_bbox": [399, 153, 3243, 319], "block_id": 1, "block_order": null, "group_id": 1, "block_polygon_points": [[399.0, 153.0], [3243.0, 153.0], [3243.0, 319.0], [399.0, 319.0]]}, {"block_label": "doc_title", "block_content": "COPYRIGHT", "block_bbox": [267, 454, 3174, 825], "block_id": 2, "block_order": 1, "group_id": 2, "block_polygon_points": [[267.0, 454.0], [3174.0, 454.0], [3174.0, 825.0], [267.0, 825.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [202, 1018, 457, 1236], "block_id": 3, "block_order": null, "group_id": 3, "block_polygon_points": [[202.0, 1018.0], [457.0, 1018.0], [457.0, 1236.0], [202.0, 1236.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [834, 1026, 1039, 1230], "block_id": 4, "block_order": null, "group_id": 4, "block_polygon_points": [[834.0, 1026.0], [1039.0, 1026.0], [1039.0, 1230.0], [834.0, 1230.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [1402, 1007, 1616, 1252], "block_id": 5, "block_order": null, "group_id": 5, "block_polygon_points": [[1402.0, 1007.0], [1616.0, 1007.0], [1616.0, 1252.0], [1402.0, 1252.0]]}, {"block_label": "text", "block_content": "COPYRIGHT PROTECTS CREATIVE WORK — YOURS, MINE, EVERYONE'S!", "block_bbox": [375, 1403, 1586, 1550], "block_id": 6, "block_order": 2, "group_id": 6, "block_polygon_points": [[375.0, 1403.0], [1586.0, 1403.0], [1586.0, 1550.0], [375.0, 1550.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [229, 2047, 412, 2234], "block_id": 7, "block_order": null, "group_id": 7, "block_polygon_points": [[229.0, 2047.0], [412.0, 2047.0], [412.0, 2234.0], [229.0, 2234.0]]}, {"block_label": "text", "block_content": "We're all both consumers and creators of creative work. As consumers, we watch movies, listen to music, read books, and more! As creators, we take photos, write songs, make videos, etc.", "block_bbox": [535, 1904, 1477, 2117], "block_id": 8, "block_order": 3, "group_id": 8, "block_polygon_points": [[535.0, 1904.0], [1477.0, 1904.0], [1477.0, 2117.0], [535.0, 2117.0]]}, {"block_label": "text", "block_content": "2\nCopyright protects creative work, so people can't generally copy or share or perform other people's work without permission.", "block_bbox": [277, 2440, 355, 2550], "block_id": 9, "block_order": 4, "group_id": 9, "block_polygon_points": [[277.0, 2440.0], [355.0, 2440.0], [355.0, 2550.0], [277.0, 2550.0]]}, {"block_label": "text", "block_content": "", "block_bbox": [519, 2526, 1486, 2692], "block_id": 10, "block_order": 5, "group_id": 9, "block_polygon_points": [[519.0, 2526.0], [1486.0, 2526.0], [1486.0, 2692.0], [519.0, 2692.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [221, 2619, 392, 2788], "block_id": 11, "block_order": null, "group_id": 11, "block_polygon_points": [[221.0, 2619.0], [392.0, 2619.0], [392.0, 2788.0], [221.0, 2788.0]]}, {"block_label": "text", "block_content": "3\nCopyright comes from the Constitution. Its purpose is to promote more creativity. The idea is that letting each of us decide what happens to our own creations will encourage us to keep creating.", "block_bbox": [268, 3008, 349, 3119], "block_id": 12, "block_order": 6, "group_id": 12, "block_polygon_points": [[268.0, 3008.0], [349.0, 3008.0], [349.0, 3119.0], [268.0, 3119.0]]}, {"block_label": "text", "block_content": "", "block_bbox": [516, 3083, 1566, 3300], "block_id": 13, "block_order": 7, "group_id": 12, "block_polygon_points": [[516.0, 3083.0], [1566.0, 3083.0], [1566.0, 3300.0], [516.0, 3300.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [236, 3218, 418, 3409], "block_id": 14, "block_order": null, "group_id": 14, "block_polygon_points": [[236.0, 3218.0], [418.0, 3218.0], [418.0, 3409.0], [236.0, 3409.0]]}, {"block_label": "text", "block_content": "4", "block_bbox": [275, 3607, 346, 3711], "block_id": 15, "block_order": 8, "group_id": 15, "block_polygon_points": [[275.0, 3607.0], [346.0, 3607.0], [346.0, 3711.0], [275.0, 3711.0]]}, {"block_label": "text", "block_content": "▶", "block_bbox": [3012, 1025, 3222, 1231], "block_id": 16, "block_order": 9, "group_id": 16, "block_polygon_points": [[3012.0, 1025.0], [3222.0, 1025.0], [3222.0, 1231.0], [3012.0, 1231.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [232, 3830, 407, 4017], "block_id": 17, "block_order": null, "group_id": 17, "block_polygon_points": [[232.0, 3830.0], [407.0, 3830.0], [407.0, 4017.0], [232.0, 4017.0]]}, {"block_label": "text", "block_content": "All creative work is protected by copyright as soon as it's written down or recorded or saved—and not just work by professional artists or big studios. Copyright protects all of us—our photos on Instagram and everything we write or create.", "block_bbox": [514, 3695, 1562, 3962], "block_id": 18, "block_order": 10, "group_id": 18, "block_polygon_points": [[514.0, 3695.0], [1562.0, 3695.0], [1562.0, 3962.0], [514.0, 3962.0]]}, {"block_label": "text", "block_content": "5", "block_bbox": [264, 4213, 340, 4328], "block_id": 19, "block_order": 11, "group_id": 19, "block_polygon_points": [[264.0, 4213.0], [340.0, 4213.0], [340.0, 4328.0], [264.0, 4328.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [241, 4467, 411, 4662], "block_id": 20, "block_order": null, "group_id": 20, "block_polygon_points": [[241.0, 4467.0], [411.0, 4467.0], [411.0, 4662.0], [241.0, 4662.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [1953, 1022, 2172, 1231], "block_id": 21, "block_order": null, "group_id": 21, "block_polygon_points": [[1953.0, 1022.0], [2172.0, 1022.0], [2172.0, 1231.0], [1953.0, 1231.0]]}, {"block_label": "text", "block_content": "• Downloading music, movies, ebooks, or games from illegal sources that operate without artists' permission.", "block_bbox": [576, 4453, 1535, 4606], "block_id": 22, "block_order": 12, "group_id": 22, "block_polygon_points": [[576.0, 4453.0], [1535.0, 4453.0], [1535.0, 4606.0], [576.0, 4606.0]]}, {"block_label": "text", "block_content": "If you copy or share other people's creative works without permission, that's called copyright infringement. Examples:", "block_bbox": [516, 4275, 1465, 4433], "block_id": 23, "block_order": 13, "group_id": 23, "block_polygon_points": [[516.0, 4275.0], [1465.0, 4275.0], [1465.0, 4433.0], [516.0, 4433.0]]}, {"block_label": "text", "block_content": "• Uploading your collection of music, movies, ebooks, or games for your friends to copy.", "block_bbox": [577, 4610, 1454, 4713], "block_id": 24, "block_order": 14, "group_id": 24, "block_polygon_points": [[577.0, 4610.0], [1454.0, 4610.0], [1454.0, 4713.0], [577.0, 4713.0]]}, {"block_label": "text", "block_content": "Copyright infringement is illegal and carries serious penalties.", "block_bbox": [518, 4732, 1378, 4834], "block_id": 25, "block_order": 15, "group_id": 25, "block_polygon_points": [[518.0, 4732.0], [1378.0, 4732.0], [1378.0, 4834.0], [518.0, 4834.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [2516, 1038, 2681, 1222], "block_id": 26, "block_order": null, "group_id": 26, "block_polygon_points": [[2516.0, 1038.0], [2681.0, 1038.0], [2681.0, 1222.0], [2516.0, 1222.0]]}, {"block_label": "paragraph_title", "block_content": "BUT COPYRIGHT DOESN'T COVER EVERYTHING", "block_bbox": [2151, 1405, 2898, 1547], "block_id": 27, "block_order": 16, "group_id": 27, "block_polygon_points": [[2151.0, 1405.0], [2898.0, 1405.0], [2898.0, 1547.0], [2151.0, 1547.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [1868, 2032, 1984, 2233], "block_id": 28, "block_order": null, "group_id": 28, "block_polygon_points": [[1868.0, 2032.0], [1984.0, 2032.0], [1984.0, 2233.0], [1868.0, 2233.0]]}, {"block_label": "text", "block_content": "Copyright gives a lot of protection, but it also has limitations. Not everything gets copyright protection. Facts and ideas are not protected by copyright, neither are US Government documents, like NASA photos and reports by federal agencies.", "block_bbox": [2111, 1894, 3183, 2163], "block_id": 29, "block_order": 17, "group_id": 29, "block_polygon_points": [[2111.0, 1894.0], [3183.0, 1894.0], [3183.0, 2163.0], [2111.0, 2163.0]]}, {"block_label": "text", "block_content": "7\nAnother limitation of copyright is “fair use,” which allows us to copy and re-use copyrighted work without the artist's permission in certain, limited ways that are still fair to the creator.", "block_bbox": [1874, 2439, 1943, 2548], "block_id": 30, "block_order": 18, "group_id": 30, "block_polygon_points": [[1874.0, 2439.0], [1943.0, 2439.0], [1943.0, 2548.0], [1874.0, 2548.0]]}, {"block_label": "text", "block_content": "", "block_bbox": [2113, 2507, 3078, 2721], "block_id": 31, "block_order": 19, "group_id": 30, "block_polygon_points": [[2113.0, 2507.0], [3078.0, 2507.0], [3078.0, 2721.0], [2113.0, 2721.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [1865, 2656, 1977, 2767], "block_id": 32, "block_order": null, "group_id": 32, "block_polygon_points": [[1865.0, 2656.0], [1977.0, 2656.0], [1977.0, 2767.0], [1865.0, 2767.0]]}, {"block_label": "text", "block_content": "8\nWhen you re-use portions of someone else's work for a school project—like using images or songs for a presentation in class—that's a fair use situation. You don't need the author's permission.", "block_bbox": [1867, 3009, 1949, 3116], "block_id": 33, "block_order": 20, "group_id": 33, "block_polygon_points": [[1867.0, 3009.0], [1949.0, 3009.0], [1949.0, 3116.0], [1867.0, 3116.0]]}, {"block_label": "text", "block_content": "", "block_bbox": [2112, 3082, 3109, 3296], "block_id": 34, "block_order": 21, "group_id": 33, "block_polygon_points": [[2112.0, 3082.0], [3109.0, 3082.0], [3109.0, 3296.0], [2112.0, 3296.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [1808, 3187, 2019, 3350], "block_id": 35, "block_order": null, "group_id": 35, "block_polygon_points": [[1808.0, 3187.0], [2019.0, 3187.0], [2019.0, 3350.0], [1808.0, 3350.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [1868, 3605, 1947, 3714], "block_id": 36, "block_order": null, "group_id": 36, "block_polygon_points": [[1868.0, 3605.0], [1947.0, 3605.0], [1947.0, 3714.0], [1868.0, 3714.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [1875, 3828, 2018, 4006], "block_id": 37, "block_order": null, "group_id": 37, "block_polygon_points": [[1875.0, 3828.0], [2018.0, 3828.0], [2018.0, 4006.0], [1875.0, 4006.0]]}, {"block_label": "text", "block_content": "Copyright protection doesn't last forever.\nEventually it expires, and the creative work falls\ninto the “public domain.” Works in the public\ndomain are free to re-use and share however\nyou want.", "block_bbox": [2111, 3697, 3043, 3961], "block_id": 38, "block_order": 22, "group_id": 38, "block_polygon_points": [[2111.0, 3697.0], [3043.0, 3697.0], [3043.0, 3961.0], [2111.0, 3961.0]]}, {"block_label": "text", "block_content": "10", "block_bbox": [1857, 4216, 1978, 4329], "block_id": 39, "block_order": 23, "group_id": 39, "block_polygon_points": [[1857.0, 4216.0], [1978.0, 4216.0], [1978.0, 4329.0], [1857.0, 4329.0]]}, {"block_label": "image", "block_content": "", "block_bbox": [1841, 4445, 1994, 4595], "block_id": 40, "block_order": null, "group_id": 40, "block_polygon_points": [[1841.0, 4445.0], [1994.0, 4445.0], [1994.0, 4595.0], [1841.0, 4595.0]]}, {"block_label": "text", "block_content": "Some creators are happy to share their creative work. They use a licensing system for sharing called Creative Commons. You can find millions of CC work that are free to share or re-use.", "block_bbox": [2112, 4382, 2965, 4645], "block_id": 41, "block_order": 24, "group_id": 41, "block_polygon_points": [[2112.0, 4382.0], [2965.0, 4382.0], [2965.0, 4645.0], [2112.0, 4645.0]]}, {"block_label": "footer_image", "block_content": "", "block_bbox": [3026, 4759, 3343, 5084], "block_id": 42, "block_order": null, "group_id": 42, "block_polygon_points": [[3026.0, 4759.0], [3343.0, 4759.0], [3343.0, 5084.0], [3026.0, 5084.0]]}, {"block_label": "footer", "block_content": "CopyrightandCreativity.org", "block_bbox": [1185, 4940, 2281, 5040], "block_id": 43, "block_order": null, "group_id": 43, "block_polygon_points": [[1185.0, 4940.0], [2281.0, 4940.0], [2281.0, 5040.0], [1185.0, 5040.0]]}], "layout_det_res": {"input_path": null, "page_index": null, "boxes": [{"cls_id": 16, "label": "number", "score": 0.4281400144100189, "coordinate": [203, 160, 364, 313], "order": 1, "polygon_points": [[203.0, 160.0], [364.0, 160.0], [364.0, 313.0], [203.0, 313.0]]}, {"cls_id": 12, "label": "header", "score": 0.5168485045433044, "coordinate": [399, 153, 3243, 319], "order": null, "polygon_points": [[399.0, 153.0], [3243.0, 153.0], [3243.0, 319.0], [399.0, 319.0]]}, {"cls_id": 6, "label": "doc_title", "score": 0.8821645975112915, "coordinate": [267, 454, 3174, 825], "order": 2, "polygon_points": [[267.0, 454.0], [3174.0, 454.0], [3174.0, 825.0], [267.0, 825.0]]}, {"cls_id": 14, "label": "image", "score": 0.8441219329833984, "coordinate": [202, 1018, 457, 1236], "order": null, "polygon_points": [[202.0, 1018.0], [457.0, 1018.0], [457.0, 1236.0], [202.0, 1236.0]